{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automicro.bot/schema/automation/ui-node.schema.json",
  "title": "NormalizedUINode",
  "$defs": {
    "UINode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "type", "name", "value", "bounds", "children"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "value": { "type": ["string", "null"] },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number" },
            "h": { "type": "number" }
          }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/UINode" }
        }
      }
    }
  },
  "$ref": "#/$defs/UINode"
}
