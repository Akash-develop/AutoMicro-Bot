{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automicro.bot/schema/automation/ipc-envelope.schema.json",
  "title": "IPCEnvelope",
  "description": "Optional wrapper for stdio/socket messages between orchestrator and child services.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "id": { "type": "string" },
    "kind": { "type": "string", "enum": ["request", "response", "event"] },
    "method": { "type": "string" },
    "params": { "type": "object" },
    "result": {},
    "error": { "type": ["string", "null"] }
  }
}
