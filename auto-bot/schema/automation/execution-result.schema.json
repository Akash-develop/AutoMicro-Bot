{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automicro.bot/schema/automation/execution-result.schema.json",
  "title": "LayerExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "success", "confidence", "method", "layer", "error", "evidence"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "success": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "method": { "type": "string", "description": "Short label e.g. DOM, AX, Vision, Input, Script" },
    "layer": {
      "type": "string",
      "enum": ["dom", "ax", "vision", "input", "script", "orchestrator"]
    },
    "error": { "type": ["string", "null"] },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "screenshotRef": { "type": "string" },
        "matchedNodeId": { "type": "string" },
        "selector": { "type": "string" }
      }
    }
  }
}
